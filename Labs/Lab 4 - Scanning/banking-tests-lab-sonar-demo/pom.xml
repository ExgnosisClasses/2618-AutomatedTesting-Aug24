<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>banking-tests-lab-sonar-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>banking-tests-lab-sonar-demo</name>
    <description>Deliberately flawed Spring Boot project for practicing SonarQube report reading</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Local SonarQube on the lab VM. No Docker. -->
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.projectKey>banking-tests-lab-sonar-demo</sonar.projectKey>
        <sonar.projectName>Banking Tests Lab (Sonar Demo)</sonar.projectName>

        <!-- Point SonarQube at the JaCoCo report produced by mvn verify -->
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>

        <jacoco.version>0.8.12</jacoco.version>
        <sonar.scanner.version>4.0.1.6619</sonar.scanner.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
             commons-collections 3.2.1 has a well-known deserialization vulnerability
             (CVE-2015-7501 / CVE-2015-6420). It is included here on purpose so that a
             dependency scanner (OWASP Dependency-Check, Snyk, etc.) reports it. SonarQube
             Community Edition does NOT report dependency CVEs out of the box - the answer
             key explains where students should look for these instead.
        -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.1</version>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- JaCoCo for coverage reporting that SonarQube will pick up -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                 SonarScanner for Maven. Pass the token on the command line:
                   mvn clean verify sonar:sonar -Dsonar.token=YOUR_TOKEN
                 Note: -Dsonar.login is deprecated; use -Dsonar.token.

                 The version is pinned deliberately: leaving it off makes every
                 build pick up whatever is newest, which is how a working lab
                 breaks overnight.
            -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.scanner.version}</version>
            </plugin>
        </plugins>
    </build>

</project>
